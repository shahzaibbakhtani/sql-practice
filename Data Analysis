use datawarehouseanalytics;
set SQL_SAFE_Updates = 0;

rename table dim_customers to customers;

select  * from dim_customers;

select * from sales;

select coalesce(month(order_date), "Null") Month_num , avg(sales_amount) 
over(partition by Month(order_date)) Average from sales order by Average desc ;


select year(order_date) Sales_Year , format(sum(sales_amount), "No") Total_Sales , 
count(distinct customer_key) as Total_customers from sales group by Sales_Year
having Sales_Year is not null order by Sales_Year;

select Month(order_date) Sales_Month , format(sum(sales_amount), "No") Total_Sales , 
count(distinct customer_key) as Total_customers, count(quantity) as Total_quantity
from sales group by Sales_Month
having Sales_Month is not null order by Sales_Month;

select month(order_date) Sales_Month , 
sum(sales_amount) Sales_per_month from sales where month(order_date) is not null
group by month(order_date) 
order by  month(order_date)
;

